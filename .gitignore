node_modules/
dist/

# Claude Code local tooling - agent/skill config and lockfiles, not part of
# the app.
.claude/
.agents/
skills-lock.json

# Stray screenshot dir from a misfired local QA script (output path resolved
# to the string "undefined").
/undefined/

# Supabase project credentials (see .env.example) - the anon key is safe to
# ship in the built client bundle (that's how Supabase's client-side auth
# model works, gated by RLS policies instead), but .env.local is still kept
# out of git so nobody has to think about which env file is "the real one"
# when setting up a fresh checkout.
.env
.env.local

# Supabase CLI's local link cache (project ref, pooler URL template, etc.) -
# regenerated by `supabase link`, no reason to track it.
supabase/.temp/

# Local Playwright screenshot helper used during feature QA - not part of
# the app, regenerated as needed.
.pw-shot.mjs
.pw-flow.mjs
.pw-diag.mjs
.pw-rt.mjs
.pw-scroll.mjs
.pw-dl.mjs
.pw-sh.mjs
.pw-sk.mjs
.pw-dc.mjs
.pw-sweep.mjs
