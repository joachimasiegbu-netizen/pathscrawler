# Copy this file to .env.local and fill in your own Supabase project's
# values (Project Settings -> API in the Supabase dashboard). .env.local is
# gitignored - never commit real values.
#
# The anon/publishable key is safe to expose in the built client bundle -
# that's how Supabase's client-side model works, access is actually
# enforced by the RLS policies on each table (see supabase/schema.sql),
# not by keeping this key secret.
#
# Also add both of these under the same names to your Vercel project's
# Settings -> Environment Variables so the production build picks them up
# too - Vite only inlines VITE_-prefixed vars at build time, so this has to
# be set before a deploy, not after.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Optional: error monitoring and analytics (src/utils/monitoring.ts).
#
# Both are OFF while these are empty, and neither SDK is downloaded. Setting
# one turns it on AND changes what /privacy says about it - the page reads the
# same flags, so the disclosure can't lag behind the wiring. Leaving them
# empty is a supported state, not an unfinished one.
# ---------------------------------------------------------------------------

# Sentry project DSN (Project Settings -> Client Keys). Not a secret: it only
# permits writing events. Sentry is configured to send no IP addresses and no
# performance traces - see monitoring.ts before changing that.
VITE_SENTRY_DSN=

# The domain exactly as registered in Plausible, e.g. pathscrawler.com. The
# cookieless, no-identifier setup is what keeps this out of consent-banner
# territory under PECR; a tool that stores an identifier would need a banner
# and a new row in DEVICE_STORAGE (src/data/legal.ts).
VITE_PLAUSIBLE_DOMAIN=

# Only for self-hosted Plausible, or a proxied script path if ad blockers
# eating plausible.io becomes a problem. Defaults to Plausible Cloud.
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.js
